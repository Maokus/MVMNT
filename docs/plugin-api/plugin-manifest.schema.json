{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://mvmnt.app/schemas/plugin-manifest.schema.json",
    "title": "MVMNT Plugin Manifest",
    "description": "Schema for MVMNT custom element plugin manifests",
    "type": "object",
    "required": ["id", "name", "version", "apiVersion", "elements"],
    "properties": {
        "id": {
            "type": "string",
            "description": "Unique plugin identifier (reverse domain notation recommended, e.g., com.example.myplugin)",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 3
        },
        "name": {
            "type": "string",
            "description": "Human-readable plugin name",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "description": "Plugin version (semantic versioning)",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
        },
        "apiVersion": {
            "type": "string",
            "description": "Compatible MVMNT plugin API version range. Plugins must target SDK 2, normally ^2.0.0.",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "description": "Human-readable plugin description"
        },
        "author": {
            "type": "string",
            "description": "Plugin author name or organization"
        },
        "homepage": {
            "type": "string",
            "format": "uri",
            "description": "Plugin homepage or repository URL"
        },
        "license": {
            "type": "string",
            "description": "Plugin license (e.g., MIT, Apache-2.0)"
        },
        "elements": {
            "type": "array",
            "description": "Array of custom elements provided by this plugin",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["type", "entry"],
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "Unique element type identifier (kebab-case recommended)",
                        "pattern": "^[a-z][a-z0-9-]*$",
                        "minLength": 1
                    },
                    "entry": {
                        "type": "string",
                        "description": "Path to element entry point relative to plugin root (e.g., elements/my-element.ts)",
                        "pattern": "^(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*\\.(js|mjs|ts)$"
                    },
                    "capabilities": {
                        "type": "object",
                        "description": "Authoritative SDK 2.x capability declaration for this external element.",
                        "additionalProperties": false,
                        "properties": {
                            "required": { "$ref": "#/definitions/capabilityList" },
                            "optional": { "$ref": "#/definitions/capabilityList" }
                        }
                    }
                }
            }
        },
        "peerDependencies": {
            "type": "object",
            "description": "Optional peer dependencies (other plugins required)",
            "additionalProperties": {
                "type": "string"
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": { "apiVersion": { "pattern": "(?:^|[^0-9])2\\." } },
                "required": ["apiVersion"]
            },
            "then": {
                "properties": {
                    "elements": {
                        "items": { "required": ["type", "entry", "capabilities"] }
                    }
                }
            }
        }
    ],
    "definitions": {
        "capabilityList": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "enum": [
                    "timeline.read",
                    "audio.features.read",
                    "audio.raw.read",
                    "timing.conversion",
                    "midi.utils",
                    "audio.calculators.register"
                ]
            }
        }
    }
}
