{
    "package": "@mvmnt-app/plugin-sdk",
    "version": "2.2.0",
    "runtimeFormat": "commonjs",
    "elementContract": {
        "renderInputType": "RenderInput",
        "renderInputFields": ["props", "time", "context", "resources", "simulation"],
        "simulationFacet": {
            "callbacks": ["initialize", "step"],
            "defaultStepSeconds": 0.008333333333333333,
            "requiredSchemaProperties": ["seed"]
        },
        "resourceContextType": "ResourceContext",
        "resourceContextFields": ["assets", "audioCalculators", "diagnostics", "signal", "onCleanup"],
        "lifecycle": ["load", "createResources", "render", "disposeResources", "unload"]
    },
    "subpaths": [
        ".",
        "api",
        "animation",
        "audio",
        "render",
        "scene",
        "safety",
        "timeline",
        "timing",
        "utils",
        "visual-assets"
    ],
    "runtimeModules": [
        "@mvmnt-app/plugin-sdk",
        "@mvmnt-app/plugin-sdk/api",
        "@mvmnt-app/plugin-sdk/animation",
        "@mvmnt-app/plugin-sdk/audio",
        "@mvmnt-app/plugin-sdk/render",
        "@mvmnt-app/plugin-sdk/scene",
        "@mvmnt-app/plugin-sdk/safety",
        "@mvmnt-app/plugin-sdk/timeline",
        "@mvmnt-app/plugin-sdk/timing",
        "@mvmnt-app/plugin-sdk/utils",
        "@mvmnt-app/plugin-sdk/visual-assets"
    ],
    "capabilities": [
        "timeline.read",
        "audio.features.read",
        "audio.raw.read",
        "timing.conversion",
        "midi.utils",
        "audio.calculators.register"
    ],
    "publicExports": {
        ".": [
            "SDK_VERSION",
            "PLUGIN_CAPABILITIES",
            "PluginContractError",
            "ok",
            "err",
            "clamp",
            "lerp",
            "invLerp",
            "remap",
            "easings",
            "FloatCurve",
            "BLEND_MODE_CHOICES",
            "prop",
            "tab",
            "group",
            "definePluginElement",
            "isPluginElementDefinition",
            "checkCapability",
            "limitRenderObjects",
            "midiNoteToName",
            "ensureEightDigitHex",
            "parseFontSelection",
            "ensureFontLoaded"
        ],
        "api": ["SDK_VERSION", "PLUGIN_CAPABILITIES", "PluginContractError", "ok", "err"],
        "animation": ["clamp", "lerp", "invLerp", "remap", "easings", "FloatCurve"],
        "audio": [],
        "render": [
            "RenderObject",
            "BoxRenderObject",
            "EmptyRenderObject",
            "Rectangle",
            "Text",
            "Line",
            "Arc",
            "Poly",
            "BezierPath",
            "GlowLayer",
            "CompositeLayer",
            "ClipLayer",
            "VisualMedia",
            "PixelGrid"
        ],
        "scene": ["BLEND_MODE_CHOICES", "prop", "tab", "group", "definePluginElement", "isPluginElementDefinition"],
        "safety": ["checkCapability", "limitRenderObjects"],
        "timeline": [],
        "timing": [],
        "utils": ["midiNoteToName", "ensureEightDigitHex", "parseFontSelection", "ensureFontLoaded"],
        "visual-assets": ["VisualMediaPlayback"]
    }
}
