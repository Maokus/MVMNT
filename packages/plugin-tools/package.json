{
    "name": "@mvmnt-app/plugin-tools",
    "version": "0.1.0",
    "description": "Build, validate, and hot-reload MVMNT plugins",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Maokus/MVMNT.git",
        "directory": "packages/plugin-tools"
    },
    "homepage": "https://github.com/Maokus/MVMNT/tree/dev/packages/plugin-tools#readme",
    "bugs": {
        "url": "https://github.com/Maokus/MVMNT/issues"
    },
    "type": "module",
    "bin": {
        "mvmnt-plugin": "bin/mvmnt-plugin.mjs"
    },
    "exports": {
        ".": {
            "types": "./src/index.d.mts",
            "import": "./src/index.mjs"
        }
    },
    "files": [
        "bin",
        "src",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@mvmnt-app/plugin-contract": "^0.1.0",
        "esbuild": "^0.28.2",
        "fflate": "^0.8.2",
        "typescript": "^5.9.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
