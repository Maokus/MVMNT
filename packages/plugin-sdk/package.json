{
    "name": "@mvmnt-app/plugin-sdk",
    "version": "2.2.0",
    "description": "Public authoring SDK for MVMNT scene element plugins",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Maokus/MVMNT.git",
        "directory": "packages/plugin-sdk"
    },
    "homepage": "https://github.com/Maokus/MVMNT/tree/dev/packages/plugin-sdk#readme",
    "bugs": {
        "url": "https://github.com/Maokus/MVMNT/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "sdk-manifest.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./api": {
            "types": "./dist/api.d.ts",
            "import": "./dist/api.js"
        },
        "./animation": {
            "types": "./dist/animation.d.ts",
            "import": "./dist/animation.js"
        },
        "./audio": {
            "types": "./dist/audio.d.ts",
            "import": "./dist/audio.js"
        },
        "./render": {
            "types": "./dist/render.d.ts",
            "import": "./dist/render.js"
        },
        "./scene": {
            "types": "./dist/scene.d.ts",
            "import": "./dist/scene.js"
        },
        "./safety": {
            "types": "./dist/safety.d.ts",
            "import": "./dist/safety.js"
        },
        "./timeline": {
            "types": "./dist/timeline.d.ts",
            "import": "./dist/timeline.js"
        },
        "./timing": {
            "types": "./dist/timing.d.ts",
            "import": "./dist/timing.js"
        },
        "./utils": {
            "types": "./dist/utils.d.ts",
            "import": "./dist/utils.js"
        },
        "./visual-assets": {
            "types": "./dist/visual-assets.d.ts",
            "import": "./dist/visual-assets.js"
        },
        "./manifest": "./sdk-manifest.json",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "typescript": "^5.9.3"
    }
}
