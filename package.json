{
    "name": "mvmnt",
    "productName": "MVMNT",
    "version": "0.15.5",
    "description": "A React-based Music Visualization application for creating social media videos from MIDI files",
    "author": "Maokus",
    "license": "AGPL-3.0",
    "repository": "https://github.com/Maokus/MVMNT",
    "main": "electron-dist/main.js",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22 <24"
    },
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "@floating-ui/react": "^0.27.16",
        "@mediabunny/aac-encoder": "^1.40.1",
        "@mediabunny/mp3-encoder": "^1.18.0",
        "@mvmnt-app/plugin-sdk": "file:packages/plugin-sdk",
        "@supabase/supabase-js": "^2.102.1",
        "@uiw/color-convert": "^2.10.1",
        "@uiw/react-color-sketch": "^2.10.1",
        "compare-versions": "^6.1.1",
        "electron-squirrel-startup": "^1.0.1",
        "fflate": "^0.8.2",
        "gifuct-js": "^2.1.2",
        "jszip": "^3.10.1",
        "mediabunny": "^1.40.1",
        "opentype.js": "^1.3.4",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-icons": "^5.5.0",
        "react-router-dom": "^6.30.4",
        "seedrandom": "^3.0.5",
        "update-electron-app": "^3.3.0",
        "web-vitals": "^2.1.0",
        "zustand": "^4.5.7"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.11.2",
        "@electron-forge/maker-dmg": "^7.11.2",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-forge/publisher-github": "^7.11.2",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^13.2.1",
        "@types/node": "^20.19.39",
        "@types/opentype.js": "^1.3.4",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/seedrandom": "^3.0.8",
        "@vitejs/plugin-react-swc": "^3.5.0",
        "appdmg": "^0.6.6",
        "autoprefixer": "^10.4.21",
        "electron": "^43.1.1",
        "jsdom": "^24.0.0",
        "knip": "^6.4.1",
        "meriyah": "^7.1.0",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.9.3",
        "vite": "^5.4.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^1.6.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "*",
        "@rollup/rollup-linux-x64-musl": "*"
    },
    "scripts": {
        "dev": "node scripts/electron-dev.mjs",
        "dev:renderer": "vite --mode desktop",
        "build:renderer": "vite build --mode desktop",
        "build:electron": "vite build --config electron/vite.main.config.ts && vite build --config electron/vite.preload.config.ts",
        "start": "electron .",
        "render": "electron . --render",
        "build": "npm run build:renderer && npm run build:electron",
        "package": "npm run build && electron-forge package",
        "make": "npm run build && electron-forge make",
        "make:mac": "npm run build && electron-forge make --platform=darwin --arch=universal",
        "make:win": "npm run build && node scripts/prepare-windows-squirrel.mjs && electron-forge make --platform=win32 --arch=x64",
        "publish": "npm run build && electron-forge publish",
        "test": "vitest run",
        "test:electron": "node scripts/electron-smoke.mjs",
        "test:watch": "vitest --watch",
        "compile": "npx tsc --noEmit && npx tsc --noEmit -p electron/tsconfig.json",
        "build-plugin": "node scripts/build-plugin.mjs",
        "dev-plugin": "node scripts/dev-plugin.mjs",
        "create-plugin": "node packages/create-mvmnt-plugin/bin/create-mvmnt-plugin.mjs",
        "build:plugin-sdk": "npm run build --workspace @mvmnt-app/plugin-sdk",
        "pack:plugin-sdk": "npm pack --workspace @mvmnt-app/plugin-sdk",
        "verify:plugin-sdk-pack": "node scripts/verify-plugin-sdk-pack.mjs",
        "orphan": "bash -c 'set -a && source .env && npx tsx \"$@\"' --",
        "linuxlock": "npm_config_platform=linux npm_config_arch=x64 npm_config_libc=glibc   npm install --package-lock-only --include=optional",
        "knip": "knip"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
