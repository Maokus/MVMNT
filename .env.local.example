# Local development environment — overrides .env for `npm run dev`.
# Packaged nightly and stable builds receive their production settings from CI.
#
# Get these values by running: supabase status  (after: supabase start)

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=<PUBLISHABLE_KEY from supabase status>

# Required to browse and embed new Google Font families.
VITE_GOOGLE_FONTS_API_KEY=<GOOGLE_WEB_FONTS_API_KEY>

# Analytics stays disabled in development unless both values are explicitly set.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<DEVELOPMENT_POSTHOG_PROJECT_TOKEN>
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_ENABLE_DEVELOPMENT=false
